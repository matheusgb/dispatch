# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/tracking-projector ./cmd/tracking-projector

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/tracking-projector /tracking-projector
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/tracking-projector"]
